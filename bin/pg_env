unset PGPORT; unset PGUSER; unset PGPASSWORD
PGVERSION=${PGVERSION:-15}
eval "PGPORT=\$PG${PGVERSION}PORT" && export PGPORT
eval "PGUSER=\$PG${PGVERSION}USER" && export PGUSER
eval "PGPASSWORD=\$PG${PGVERSION}PASSWORD" && export PGPASSWORD
export PATH=/usr/lib/postgresql/${PGVERSION}/bin:${PATH}

# vim: ft=sh
